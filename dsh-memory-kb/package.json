{
  "name": "dsh-memory-kb",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 记忆与知识库 Workbench：自动沉淀/召回、技能、新闻、记忆审核、RAG 问答、成本估算、会话导出与代码文件预览。",
  "repository": {
    "type": "git",
    "url": "https://github.com/luckyunhao/dsh-memory-wbh.git"
  },
  "homepage": "https://github.com/luckyunhao/dsh-memory-wbh#readme",
  "bugs": {
    "url": "https://github.com/luckyunhao/dsh-memory-wbh/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node test/run-all.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "client-src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "knowledge-base",
    "skill"
  ],
  "license": "MIT"
}
